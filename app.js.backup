// ==================== 数字计数器动画 ====================

/**
 * 初始化数字计数器动画
 */
function initCounters() {
  DVLogger.init('initCounters');
  const counters = document.querySelectorAll('.metric-value[data-target]');

  // Bug #131 - 使用单个共享 IntersectionObserver，避免每个计数器创建一个
  if (DataVision.counterObserver) {
    DataVision.counterObserver.disconnect();
  }

  DataVision.counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counter = entry.target;
        // Bug #228 - 设置 _counterAnimating 标志，防止与 switchSection 双触发
        counter._counterAnimating = true;
        const target = parseFloat(counter.dataset.target);
        const prefix = counter.dataset.prefix || '';
        const suffix = counter.dataset.suffix || '';
        const duration = 2000;
        let startTime = null;

        const updateCounter = (currentTime) => {
          // Bug #131 - 检查元素是否仍在DOM中
          if (!counter.isConnected) return;
          if (startTime === null) startTime = currentTime;
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const current = target * easeProgress;

          if (target % 1 !== 0) {
            counter.textContent = prefix + current.toFixed(2) + suffix;
          } else {
            counter.textContent = prefix + Math.floor(current).toLocaleString() + suffix;
          }

          if (progress < 1) {
            counter._counterAnimFrame = requestAnimationFrame(updateCounter);
          } else {
            // Bug #228 - 动画完成后重置标志
            counter._counterAnimating = false;
          }
        };

        requestAnimationFrame(updateCounter);
        DataVision.counterObserver.unobserve(counter);
      }
    });
  }, { threshold: 0.1 });

  counters.forEach(counter => DataVision.counterObserver.observe(counter));
}

