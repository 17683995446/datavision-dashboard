/**
 * 初始化仪表盘图表（半圆环形图）
 */
function initGauges() {
  DVLogger.init('initGauges');
  const colors = getChartThemeColors();
  const gaugeConfigs = [
    { id: 'serverLoadGauge', value: 42, color: '#10b981' },
    { id: 'memoryGauge', value: 68, color: '#f59e0b' },
    { id: 'networkGauge', value: 75, color: '#667eea' }
  ];

  gaugeConfigs.forEach(config => {
    const chart = createChart(config.id, {
      type: 'doughnut',
      data: {
        datasets: [{
          data: [config.value, 100 - config.value],
          backgroundColor: [config.color, colors.border],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '85%',
        rotation: -90,
        circumference: 180,
        plugins: {
          legend: { display: false },
          tooltip: { enabled: false }
        }
      }
    });
    if (chart) {
      DataVision.gaugeCharts[config.id] = chart;
      // Bug #87 - 存储初始值用于回归算法
      chart._initialGaugeValue = config.value;
    }
  });
}

