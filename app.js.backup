// 状态映射表
const statusMap = {
  completed: { text: '已完成', class: 'completed' },
  pending: { text: '处理中', class: 'pending' },
  failed: { text: '失败', class: 'failed' }
};

/**
 * 初始化交易表格
 * Bug #88, #104 - 恢复保存的搜索状态
 */
function initTable() {
  DVLogger.init('initTable');
  // 尝试恢复保存的搜索状态
  try {
    const savedSearch = sessionStorage.getItem('dv_searchQuery');
    const savedStatus = sessionStorage.getItem('dv_statusFilter');
    const savedPage = sessionStorage.getItem('dv_currentPage');
    
    if (savedSearch !== null) {
      currentSearchQuery = savedSearch;
      DVLogger.state('currentSearchQuery', currentSearchQuery);
      const searchInput = document.querySelector('#overview .search-box input');
      if (searchInput) {
        // Bug #243 - 恢复搜索值时进行HTML转义，防止XSS
        searchInput.value = escapeHtml(savedSearch);
      }
    }
    if (savedStatus !== null) {
      currentStatusFilter = savedStatus;
      DVLogger.state('currentStatusFilter', currentStatusFilter);
    }
    if (savedPage !== null) {
      currentPage = parseInt(savedPage, 10) || 1;
      DVLogger.state('currentPage', currentPage);
    }
  } catch (e) { /* ignore */ }

  // Bug #170 - 初始化时传入 fromInit 标志，不重置页码
  applyFilters({ fromInit: true });
}

/**
 * 根据当前筛选条件和搜索词过滤并渲染表格
 * Bug #88, #102, #104, #110 - 修复筛选和分页状态不一致问题
 * @param {Object} options - 可选参数
 * @param {boolean} options.fromPagination - 是否来自分页操作（不重置页码）
 * @param {boolean} options.fromDelete - 是否来自删除操作（智能调整页码）
 * @param {boolean} options.fromInit - 是否来自初始化（不重置页码）
 */
function applyFilters(options = {}) {
  DVLogger.init('applyFilters');
  DVLogger.branch('fromPagination', options.fromPagination);
  DVLogger.branch('fromInit', options.fromInit);
  DVLogger.branch('fromDelete', options.fromDelete);
  // Bug #88 - 保存搜索状态到sessionStorage，页面切换后可恢复
  try {
    sessionStorage.setItem('dv_searchQuery', currentSearchQuery);
    sessionStorage.setItem('dv_statusFilter', currentStatusFilter);
  } catch (e) { /* ignore */ }

  // 应用搜索和状态筛选
  // Bug #97 - 搜索查询已经转义，使用原始值进行匹配
  const rawQuery = currentSearchQuery.replace(/\\([.*+?^${}()|[\]\\])/g, '$1').toLowerCase();
  filteredTransactions = allTransactions.filter(trx => {
    // 状态筛选
    const statusMatch = currentStatusFilter === 'all' || trx.status === currentStatusFilter;
    // 搜索筛选（匹配ID、客户名、产品名）
    const searchMatch = !rawQuery ||
      trx.id.toLowerCase().includes(rawQuery) ||
      trx.customer.toLowerCase().includes(rawQuery) ||
      trx.product.toLowerCase().includes(rawQuery);
    return statusMatch && searchMatch;
  });
  DVLogger.boundary('filteredTransactions.length', filteredTransactions.length);

  // Bug #110 - 移除错误的URL参数检测，使用显式参数控制页码重置
  // Bug #170 - fromInit 时也不重置页码
  if (!options.fromPagination && !options.fromInit) {
    if (options.fromDelete) {
      // Bug #121 - 删除后智能调整页码：如果当前页已空则回退
      const totalPages = Math.ceil(filteredTransactions.length / pageSize);
      if (currentPage > totalPages && totalPages > 0) {
        currentPage = totalPages;
        DVLogger.state('currentPage', currentPage);
      }
      // 如果删除后没有数据了，回到第1页
      if (filteredTransactions.length === 0) {
        currentPage = 1;
        DVLogger.state('currentPage', currentPage);
      }
    } else {
      // 搜索/筛选变化时重置到第一页
      currentPage = 1;
      DVLogger.state('currentPage', currentPage);
    }
  }
  // Bug #135 - 同步 currentPage 到 sessionStorage，防止导航后恢复旧页码
  try {
    sessionStorage.setItem('dv_currentPage', currentPage);
  } catch (e) { /* ignore */ }
  renderTable();
  renderPagination();
}

/**
 * 渲染当前页的表格数据
 */
function renderTable() {
  DVLogger.init('renderTable');
  const tableBody = document.getElementById('transactionTable');
  if (!tableBody) return;

  const startIndex = (currentPage - 1) * pageSize;
  const endIndex = startIndex + pageSize;
  const pageData = filteredTransactions.slice(startIndex, endIndex);

  if (pageData.length === 0) {
    DVLogger.branch('pageData_empty', true);
    // Bug #232 - 动态计算 colspan，不再硬编码为 7
    const thead = tableBody.closest('table')?.querySelector('thead');
    const colCount = thead ? thead.querySelectorAll('th').length : 7;
    const cols = colCount;
    tableBody.innerHTML = `<tr><td colspan="${cols}" style="text-align:center;padding:48px 20px;color:var(--text-tertiary);grid-column:1/-1;"><div style="display:flex;flex-direction:column;align-items:center;gap:8px;"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span>暂无匹配的交易记录</span><span style="font-size:12px;">请尝试调整搜索条件或筛选状态</span></div></td></tr>`;
    // Also hide pagination when no results
    const paginationContainer = document.querySelector('#overview .pagination');
    if (paginationContainer) paginationContainer.style.display = 'none';
    return;
  }
  // Make sure pagination is visible when there are results
  const paginationContainer = document.querySelector('#overview .pagination');
  if (paginationContainer) paginationContainer.style.display = 'flex';

  tableBody.innerHTML = pageData.map(trx => {
    // Bug #45 - statusMap missing defensive check
    // Bug #214 - 未知状态使用 'pending' class（不是 'status-pending'）
    const statusInfo = statusMap[trx.status] || { text: '未知', class: 'pending' };
    return `
    <tr>
      <td><code>${escapeHtml(trx.id)}</code></td>
      <td>${escapeHtml(trx.customer)}</td>
      <td>${escapeHtml(trx.product)}</td>
      <td>¥${trx.amount.toLocaleString()}</td>
      <td>
        <span class="status-badge ${statusInfo.class}">
          <span class="status-dot-small"></span>
          ${statusInfo.text}
        </span>
      </td>
      <td>${escapeHtml(trx.time)}</td>
      <td>
        <button class="btn-icon table-action-btn" data-trx-id="${escapeHtml(trx.id)}" style="width: 32px; height: 32px;" aria-label="更多操作">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="1"/>
            <circle cx="19" cy="12" r="1"/>
            <circle cx="5" cy="12" r="1"/>
          </svg>
        </button>
      </td>
    </tr>
  `;
  }).join('');

  // 更新页码信息
  const pageInfo = document.querySelector('#overview .page-info');
  if (pageInfo) {
    const total = filteredTransactions.length;
    const showStart = total > 0 ? startIndex + 1 : 0;
    const showEnd = Math.min(endIndex, total);
    pageInfo.textContent = `显示 ${showStart}-${showEnd} 共 ${total} 条`;
  }

  // Bug #47 - No longer rebinds on every render; event delegation handles it
}

// ==================== 搜索功能 ====================

/**
 * 初始化搜索框实时过滤
 * Bug #32, #89, #97 - 添加防抖和特殊字符转义
 */
function initSearch() {
  DVLogger.init('initSearch');
  const searchInput = document.querySelector('#overview .search-box input');
  if (!searchInput) return;

  searchInput.addEventListener('input', (e) => {
    // Bug #89 - 使用命名空间管理防抖定时器
    if (DataVision.searchDebounceTimer) clearTimeout(DataVision.searchDebounceTimer);
    DataVision.searchDebounceTimer = setTimeout(() => {
      DVLogger.timer('setTimeout', 'searchDebounce');
      // Bug #97 - 处理特殊字符，防止正则注入
      currentSearchQuery = escapeSearchQuery(e.target.value.trim());
      DVLogger.state('currentSearchQuery', currentSearchQuery);
      applyFilters();
    }, 300);
  });
}

/**
 * Bug #97 - 转义搜索查询中的正则特殊字符
 */
function escapeSearchQuery(query) {
  DVLogger.init('escapeSearchQuery');
  if (!query) return '';
  // 转义正则特殊字符，但保留用户想搜索的字符
  return query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// ==================== 分页功能 ====================

/**
 * 初始化分页按钮事件
 * Bug #90, #102 - 修复分页焦点恢复和状态保持
 */
function initPagination() {
  DVLogger.init('initPagination');
  const paginationContainer = document.querySelector('.pagination');
  if (!paginationContainer) return;

  paginationContainer.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-page');
    if (!btn || btn.disabled) return;

    const text = btn.textContent.trim();
    let pageChanged = false;
    let targetPage = currentPage;

    // Bug #204 - 使用 data-direction 属性代替 SVG 匹配来识别分页方向
    const direction = btn.dataset.direction;
    if (direction === 'prev') {
      DVLogger.branch('pagination_prev', currentPage);
      if (currentPage > 1) {
        targetPage = currentPage - 1;
        pageChanged = true;
      }
    }
    // 下一页
    else if (direction === 'next') {
      DVLogger.branch('pagination_next', currentPage);
      const totalPages = Math.ceil(filteredTransactions.length / pageSize);
      if (currentPage < totalPages) {
        targetPage = currentPage + 1;
        pageChanged = true;
      }
    }
    // 页码按钮
    else {
      const pageNum = parseInt(text);
      DVLogger.branch('pagination_number', pageNum);
      if (!isNaN(pageNum) && pageNum !== currentPage) {
        targetPage = pageNum;
        pageChanged = true;
      }
    }

    // Bug #102 - 只有页面真正改变时才重新渲染
    if (pageChanged) {
      currentPage = targetPage;
      DVLogger.state('currentPage', currentPage);
      // Bug #88 - 保存页码到sessionStorage
      try {
        sessionStorage.setItem('dv_currentPage', currentPage);
      } catch (e) { /* ignore */ }
      renderTable();
      renderPagination();
      
      // Bug #90 - 分页后恢复焦点到当前页按钮
      requestAnimationFrame(() => {
        const activeBtn = paginationContainer.querySelector('.btn-page.active');
        if (activeBtn) {
          activeBtn.focus();
          // Bug #177 - 修正选择器 .table-container → .table-card
          const tableContainer = document.querySelector('#overview .table-card');
          if (tableContainer) {
            tableContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      });
    }
  });
}

/**
 * 渲染分页按钮
 */
function renderPagination() {
  DVLogger.init('renderPagination');
  const paginationContainer = document.querySelector('.pagination');
  if (!paginationContainer) return;

  const totalPages = Math.ceil(filteredTransactions.length / pageSize);
  if (totalPages <= 0) return;

  let html = '';

  // 上一页按钮
  // Bug #204 - 添加 data-direction 属性
  html += `<button class="btn-page" data-direction="prev" ${currentPage === 1 ? 'disabled' : ''} aria-label="上一页">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>`;

  // 计算显示的页码范围
  const pages = generatePageNumbers(currentPage, totalPages);
  pages.forEach(p => {
    if (p === '...') {
      html += '<span class="page-ellipsis">...</span>';
    } else {
      html += `<button class="btn-page ${p === currentPage ? 'active' : ''}" aria-label="第${p}页">${p}</button>`;
    }
  });

  // 下一页按钮
  // Bug #204 - 添加 data-direction 属性
  html += `<button class="btn-page" data-direction="next" ${currentPage === totalPages ? 'disabled' : ''} aria-label="下一页">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>`;

  paginationContainer.innerHTML = html;

  // Bug #117 - 不在renderPagination中自动focus，由调用方决定是否focus
  // focus逻辑统一在initPagination的click handler中处理
}

/**
 * 生成页码数组（包含省略号）
 */
function generatePageNumbers(current, total) {
  DVLogger.init('generatePageNumbers');
  // Bug #143 - 阈值从7调整为9，提供更平滑的分页过渡
  if (total <= 9) {
    DVLogger.boundary('total_small', total);
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages = [];
  pages.push(1);

  if (current > 3) {
    DVLogger.boundary('ellipsis_left', current);
    pages.push('...');
  }

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    DVLogger.boundary('ellipsis_right', current);
    pages.push('...');
  }

  pages.push(total);

  return pages;
}

// ==================== 日期范围切换 ====================

/**
 * 初始化日期范围按钮切换
 * Bug #41/#64 - Time range now updates charts and trend percentages
 * Bug #42 - Trend percentages update with time range
 */
function initDateRange() {
  DVLogger.init('initDateRange');
  const rangeButtons = document.querySelectorAll('.btn-range');
  if (rangeButtons.length === 0) return;

  // 不同时间范围的模拟数据
  const rangeData = {
    '今日': { revenue: 2847500, users: 45231, orders: 1825, conversion: 3.24 },
    '本周': { revenue: 18925000, users: 312450, orders: 12850, conversion: 3.18 },
    '本月': { revenue: 76450000, users: 1285000, orders: 54200, conversion: 3.42 },
    '全年': { revenue: 284750000, users: 5420000, orders: 218000, conversion: 3.56 }
  };

  // Bug #42 - Trend percentages for each time range
  const trendData = {
    '今日': ['+12.5%', '+8.2%', '+5.1%', '+0.3%'],
    '本周': ['+15.3%', '+10.5%', '+7.8%', '+0.5%'],
    '本月': ['+18.7%', '+12.1%', '+9.4%', '+0.8%'],
    '全年': ['+21.2%', '+15.6%', '+11.2%', '+1.2%']
  };

  // Bug #41/#64 - Chart data for each time range
  const chartDataByRange = {
    '今日': {
      revenue: [180000, 210000, 195000, 240000, 220000, 260000, 280000, 250000, 290000, 310000, 270000, 284750],
      revenuePrev: [150000, 170000, 160000, 190000, 180000, 210000, 220000, 200000, 230000, 240000, 220000, 235000],
      labels: ['1时', '2时', '3时', '4时', '5时', '6时', '7时', '8时', '9时', '10时', '11时', '12时']
    },
    '本周': {
      revenue: [2200000, 2500000, 2800000, 2600000, 3100000, 2900000, 2847500],
      revenuePrev: [1900000, 2100000, 2400000, 2200000, 2700000, 2500000, 2350000],
      labels: ['周一', '周二', '周三', '周四', '周五', '周六', '周日']
    },
    '本月': {
      revenue: [1800000, 2100000, 1950000, 2400000, 2200000, 2600000, 2800000, 2500000, 2900000, 3100000, 2700000, 2847500],
      revenuePrev: [1500000, 1700000, 1600000, 1900000, 1800000, 2100000, 2200000, 2000000, 2300000, 2400000, 2200000, 2350000],
      labels: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
    },
    '全年': {
      revenue: [18000000, 21000000, 19500000, 24000000, 22000000, 26000000, 28000000, 25000000, 29000000, 31000000, 27000000, 28475000],
      revenuePrev: [15000000, 17000000, 16000000, 19000000, 18000000, 21000000, 22000000, 20000000, 23000000, 24000000, 22000000, 23500000],
      labels: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
    }
  };

  rangeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // 切换 active 样式
      rangeButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // 根据选择的时间范围更新指标数据
      const range = btn.textContent.trim();
      DVLogger.branch('dateRange_selected', range);
      const data = rangeData[range];
      if (!data) return;

      // 更新指标卡片的 data-target 和显示值
      const metricCards = document.querySelectorAll('.metric-value[data-target]');
      const targets = [data.revenue, data.users, data.orders, data.conversion];
      const prefixes = ['¥', '', '', ''];
      const suffixes = ['', '', '', '%'];

      metricCards.forEach((card, index) => {
        if (index < targets.length) {
          card.dataset.target = targets[index];
          card.dataset.prefix = prefixes[index];
          card.dataset.suffix = suffixes[index];

          // 重新播放数字动画
          animateCounter(card, targets[index], prefixes[index], suffixes[index]);
        }
      });

      // Bug #42 - Update trend percentages
      const trends = trendData[range];
      if (trends) {
        const trendElements = document.querySelectorAll('.metric-trend');
        trendElements.forEach((el, index) => {
          if (index < trends.length) {
            const trendText = el.querySelector('span') || el;
            // Keep the SVG icon, update the text node
            const svgEl = el.querySelector('svg');
            if (svgEl) {
              // Remove old text nodes after SVG
              while (el.lastChild && el.lastChild !== svgEl) {
                el.removeChild(el.lastChild);
              }
              // Remove text nodes before SVG
              while (el.firstChild && el.firstChild !== svgEl) {
                el.removeChild(el.firstChild);
              }
              el.appendChild(document.createTextNode(trends[index]));
            }
          }
        });
      }

      // Bug #41/#64 - Update chart data for the selected time range
      const chartRangeData = chartDataByRange[range];
      if (chartRangeData) {
        // Update revenue chart
        const revenueChart = chartInstances.find(c => c.canvas && c.canvas.id === 'revenueChart');
        if (revenueChart) {
          revenueChart.data.labels = chartRangeData.labels;
          revenueChart.data.datasets[0].data = chartRangeData.revenue;
          revenueChart.data.datasets[1].data = chartRangeData.revenuePrev;
          // Bug #150 - 先用 'none' 模式取消进行中的动画，再正常更新
          revenueChart.update('none');
        }
      }
    });
  });
}

/**
 * 对单个计数器执行数字动画
 * Bug #62 - animateCounter now cancellable: stores animationFrame ID on element
 * Bug #92 - 处理极端数值格式化
 */
function animateCounter(element, target, prefix, suffix) {
  DVLogger.init('animateCounter');
  // Bug #62 - Cancel previous animation if any
  if (element._counterAnimFrame) {
    cancelAnimationFrame(element._counterAnimFrame);
  }
  // Bug #236 - 设置动画中标志，防止 IO 重复触发
  element._counterAnimating = true;

  const duration = 1000;
  const startTime = performance.now();
  // Bug #136 - 使用存储的实际数值作为起始值，而非解析格式化文本
  const startValue = element._currentValue || 0;

  // Bug #92 - 格式化数值，处理极端值
  function formatNumber(num, isFinal = false) {
    if (!isFinite(num)) return '0';
    // 处理极大值（超过1万亿）
    if (Math.abs(num) >= 1e12) {
      DVLogger.boundary('num_extreme', num);
      return (num / 1e12).toFixed(isFinal ? 2 : 1) + 'T';
    }
    // 处理大值（超过1亿）
    if (Math.abs(num) >= 1e8) {
      DVLogger.boundary('num_large', num);
      return (num / 1e8).toFixed(isFinal ? 2 : 1) + '亿';
    }
    // 处理较大值（超过1万）
    if (Math.abs(num) >= 1e4) {
      DVLogger.boundary('num_medium', num);
      // Bug #137 - 最终值使用 Math.round 保证精度，中间值使用 toFixed(1)
      return isFinal
        ? (Math.round(num / 1e4 * 10) / 10) + '万'
        : (num / 1e4).toFixed(0) + '万';
    }
    // 处理小数
    if (target % 1 !== 0) {
      DVLogger.boundary('num_decimal', num);
      return num.toFixed(2);
    }
    // 普通整数
    DVLogger.boundary('num_integer', num);
    return Math.floor(num).toLocaleString();
  }

  function update(currentTime) {
    const elapsed = currentTime - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const easeProgress = 1 - Math.pow(1 - progress, 3);
    const current = startValue + (target - startValue) * easeProgress;

    const isFinal = progress >= 1;
    element.textContent = prefix + formatNumber(current, isFinal) + suffix;

    if (progress < 1) {
      element._counterAnimFrame = requestAnimationFrame(update);
    } else {
      element._counterAnimFrame = null;
      // Bug #4 - Mark counter as animated when complete
      element._counterAnimated = true;
      // Bug #136 - 存储实际数值，供下次动画使用
      element._currentValue = target;
      // Bug #236 - 清除动画中标志
      element._counterAnimating = false;
    }
  }

  element._counterAnimFrame = requestAnimationFrame(update);
}

// ==================== 导出报表按钮 ====================

/**
 * 初始化导出报表按钮
 * Bug #40 - Implement actual CSV export
 * Bug #38 - Also bind analysis page export button
 */
function initExportButton() {
  DVLogger.init('initExportButton');
  // Bind both overview and analytics export buttons
  // Bug #11 - Note: selector '#overview .btn-primary, #analytics .btn-primary' is intentionally broad.
  // This works because currently only the export buttons use .btn-primary in these sections.
  // If additional .btn-primary buttons are added, consider using a more specific selector
  // such as [data-action="export"] or .btn-export class for better targeting.
  const exportBtns = document.querySelectorAll('#overview .btn-primary, #analytics .btn-primary');
  exportBtns.forEach(exportBtn => {
    exportBtn.addEventListener('click', () => {
      // Bug #120 - 防止重复点击导出
      if (DataVision.exportInProgress) {
        DVLogger.branch('exportInProgress_lock', true);
        showToast('导出正在进行中，请稍候', 'warning');
        return;
      }
      const statusTextMap = { completed: '已完成', pending: '处理中', failed: '失败' };
      const headers = ['交易ID', '客户', '产品', '金额', '状态', '时间'];

      // Bug #101 - 大数据量分块处理，避免阻塞UI
      const CHUNK_SIZE = 1000; // 每批处理1000条
      // Bug #130 - 导出时对 filteredTransactions 做快照，防止导出过程中数据被修改
      const exportData = [...filteredTransactions];
      const totalRows = exportData.length;

      // Bug #120 - 设置导出锁
      DataVision.exportInProgress = true;
      DVLogger.state('exportInProgress', true);

      if (totalRows === 0) {
        DVLogger.branch('totalRows_zero', true);
        DataVision.exportInProgress = false;
        DVLogger.state('exportInProgress', false);
        showToast('没有可导出的数据', 'warning');
        return;
      }
      
      // 显示导出进度
      showToast(`正在导出 ${totalRows} 条数据...`, 'info');
      
      // 使用 requestIdleCallback 或 setTimeout 分块处理
      const processChunk = (startIdx) => {
        const endIdx = Math.min(startIdx + CHUNK_SIZE, totalRows);
        const csvRows = [];
        
        for (let i = startIdx; i < endIdx; i++) {
          const trx = exportData[i];
          const row = [
            trx.id,
            trx.customer,
            trx.product,
            trx.amount,
            statusTextMap[trx.status] || trx.status,
            trx.time
          ].map(field => {
            // Bug #208 - 正确处理包含换行符和逗号的字段值
            const str = String(field).replace(/"/g, '""');
            return `"${str}"`;
          });
          csvRows.push(row.join(','));
        }
        
        return csvRows;
      };
      
      // 同步处理（小数据量）或分块处理（大数据量）
      if (totalRows <= CHUNK_SIZE) {
        DVLogger.branch('CHUNK_SIZE_sync', totalRows);
        try {
          const csvRows = [headers.map(h => `"${h}"`).join(',')];
          csvRows.push(...processChunk(0));

          const csvContent = '\uFEFF' + csvRows.join('\n'); // BOM for Chinese characters
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `交易数据导出_${new Date().toISOString().slice(0,10)}.csv`;
          // Bug #188 - Safari 兼容：先添加到 DOM 再触发点击
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          // Bug #199 - 延长 revokeObjectURL 超时到 60s
          setTimeout(() => URL.revokeObjectURL(url), 60000);
          showToast('报表导出成功', 'success');
        } catch (e) {
          console.error('导出失败:', e);
          showToast('导出失败，请重试', 'error');
        }
        DataVision.exportInProgress = false;
        DVLogger.state('exportInProgress', false);
      } else {
        // 大数据量使用分块处理
        const csvRows = [headers.join(',')];
        let processedCount = 0;

        const processNextChunk = () => {
          try {
            const chunk = processChunk(processedCount);
            csvRows.push(...chunk);
            processedCount += chunk.length;

            if (processedCount < totalRows) {
              // 继续处理下一块
              setTimeout(processNextChunk, 0);
            } else {
              // 全部处理完成，触发下载
              try {
                const csvContent = '\uFEFF' + csvRows.join('\n');
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `交易数据导出_${new Date().toISOString().slice(0,10)}.csv`;
                // Bug #188 - Safari 兼容：先添加到 DOM 再触发点击
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                // Bug #199 - 延长 revokeObjectURL 超时到 60s
                setTimeout(() => URL.revokeObjectURL(url), 60000);
                showToast(`成功导出 ${totalRows} 条数据`, 'success');
                DataVision.exportInProgress = false;
                DVLogger.state('exportInProgress', false);
              } catch (e) {
                console.error('导出失败:', e);
                showToast('导出失败，请重试', 'error');
                DataVision.exportInProgress = false;
                DVLogger.state('exportInProgress', false);
              }
            }
          } catch (e) {
            // Bug #173 - try-catch 包裹整个 processNextChunk 体
            console.error('导出处理失败:', e);
            showToast('导出过程中发生错误', 'error');
            DataVision.exportInProgress = false;
            DVLogger.state('exportInProgress', false);
          }
        };

        processNextChunk();
      }
    });
  });
}

// ==================== 筛选面板 ====================

/**
 * 初始化筛选按钮和筛选面板
 * Bug #49 - Changed to position: fixed + document.body.appendChild + getBoundingClientRect()
 */
function initFilterPanel() {
  DVLogger.init('initFilterPanel');
  const filterBtn = document.querySelector('#overview .table-actions .btn-secondary');
  if (!filterBtn) return;

  // Bug #140 - 防止重复创建筛选面板
  const existingPanel = document.querySelector('.filter-panel');
  if (existingPanel) existingPanel.remove();

  // 创建筛选面板
  const filterPanel = document.createElement('div');
  filterPanel.className = 'filter-panel';
  filterPanel.style.cssText = `
    position:fixed;
    background:var(--bg-primary);border:1px solid var(--border);
    border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,0.15);
    padding:8px;min-width:160px;z-index:50;
    display:none;
  `;
  filterPanel.innerHTML = `
    <div class="filter-option" data-status="all" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:14px;color:var(--text-primary);transition:background 0.15s;">全部</div>
    <div class="filter-option" data-status="completed" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:14px;color:var(--text-primary);transition:background 0.15s;">已完成</div>
    <div class="filter-option" data-status="pending" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:14px;color:var(--text-primary);transition:background 0.15s;">处理中</div>
    <div class="filter-option" data-status="failed" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:14px;color:var(--text-primary);transition:background 0.15s;">失败</div>
  `;

  // Bug #49 - Append to body and use fixed positioning
  document.body.appendChild(filterPanel);

  // 点击筛选按钮切换面板显示
  filterBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    closeAllPanels();
    const isVisible = filterPanel.style.display === 'block';
    if (!isVisible) {
      const rect = filterBtn.getBoundingClientRect();
      filterPanel.style.top = (rect.bottom + 8) + 'px';
      filterPanel.style.left = rect.left + 'px';
      filterPanel.style.display = 'block';

      // Bug #7 - Add resize listener to update filter panel position
      // Bug #155 - 先移除旧的 resize 监听器再添加新的
      if (DataVision.handlers.filterResize) {
        window.removeEventListener('resize', DataVision.handlers.filterResize);
      }
      DataVision.handlers.filterResize = () => {
        if (filterPanel.style.display === 'block') {
          const r = filterBtn.getBoundingClientRect();
          filterPanel.style.top = (r.bottom + 8) + 'px';
          filterPanel.style.left = r.left + 'px';
        }
      };
      window.addEventListener('resize', DataVision.handlers.filterResize);
    } else {
      filterPanel.style.display = 'none';
    }
  });

  // 筛选选项点击事件
  filterPanel.querySelectorAll('.filter-option').forEach(option => {
    // 悬停效果
    option.addEventListener('mouseenter', () => {
      option.style.background = 'var(--bg-secondary)';
    });
    option.addEventListener('mouseleave', () => {
      option.style.background = 'transparent';
    });

    option.addEventListener('click', () => {
      currentStatusFilter = option.dataset.status;
      DVLogger.state('currentStatusFilter', currentStatusFilter);

      // Bug #230 - 使用 textContent 会清除所有子元素，但此处 filterBtn 只有文本，安全
      // 如果 filterBtn 包含图标等子元素，应改为只修改文本节点
      const statusTextMap = { all: '筛选', completed: '筛选: 已完成', pending: '筛选: 处理中', failed: '筛选: 失败' };
      filterBtn.textContent = statusTextMap[currentStatusFilter];

      // 关闭面板
      filterPanel.style.display = 'none';

      // 重新过滤表格
      applyFilters();
    });
  });
}

// ==================== 表格操作按钮（下拉菜单） ====================

/**
 * 初始化表格操作按钮（事件委托）
 * Bug #47 - Single click listener on tbody
 * Bug #50 - Action dropdown uses position: fixed + getBoundingClientRect()
 * Bug #35 - XSS in action dropdown trxId
 * Bug #53 - Transaction delete actually removes from allTransactions
 */
function initTableActions() {
  DVLogger.init('initTableActions');
  const tableBody = document.getElementById('transactionTable');
  if (!tableBody) return;

  // Bug #47 - Event delegation: single click listener on tbody
  tableBody.addEventListener('click', (e) => {
    const btn = e.target.closest('.table-action-btn');
    if (!btn) return;

    e.stopPropagation();
    const trxId = btn.dataset.trxId;

    // Toggle: if this row already has a dropdown, close it
    const existingDropdown = btn.closest('td').querySelector('.action-dropdown');
    if (existingDropdown) {
      existingDropdown.remove();
      return;
    }

    // 关闭已打开的其他菜单
    closeAllDropdowns();

    // 创建下拉菜单
    const dropdown = document.createElement('div');
    dropdown.className = 'action-dropdown';
    // Bug #50 - Use position: fixed
    dropdown.style.cssText = `
      position:fixed;
      background:var(--bg-primary);border:1px solid var(--border);
      border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,0.15);
      padding:4px;min-width:140px;z-index:50;
    `;
    // Bug #35 - Escape trxId in innerHTML
    const escapedTrxId = escapeHtml(trxId);
    dropdown.innerHTML = `
      <div class="action-item" data-action="view" data-trx-id="${escapedTrxId}" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px;color:var(--text-primary);display:flex;align-items:center;gap:8px;transition:background 0.15s;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        查看详情
      </div>
      <div class="action-item" data-action="edit" data-trx-id="${escapedTrxId}" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px;color:var(--text-primary);display:flex;align-items:center;gap:8px;transition:background 0.15s;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        编辑
      </div>
      <div class="action-item" data-action="delete" data-trx-id="${escapedTrxId}" style="padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px;color:#ef4444;display:flex;align-items:center;gap:8px;transition:background 0.15s;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        删除
      </div>
    `;

    // Bug #50 - Position using getBoundingClientRect, handle viewport overflow
    const btnRect = btn.getBoundingClientRect();
    let top = btnRect.bottom + 4;
    let left = btnRect.right - 140; // align to right of button

    // Prevent overflow at bottom
    const dropdownHeight = 130;
    if (top + dropdownHeight > window.innerHeight) {
      top = btnRect.top - dropdownHeight - 4;
    }
    // Prevent overflow at left
    if (left < 8) {
      left = 8;
    }
    // Prevent overflow at right
    if (left + 140 > window.innerWidth) {
      left = window.innerWidth - 148;
    }

    dropdown.style.top = top + 'px';
    dropdown.style.left = left + 'px';

    document.body.appendChild(dropdown);

    // 悬停效果
    dropdown.querySelectorAll('.action-item').forEach(item => {
      item.addEventListener('mouseenter', () => {
        item.style.background = 'var(--bg-secondary)';
      });
      item.addEventListener('mouseleave', () => {
        item.style.background = 'transparent';
      });

      item.addEventListener('click', () => {
        const action = item.dataset.action;
        const id = item.dataset.trxId;

        if (action === 'view') {
          showToast(`正在查看交易 ${id} 的详情`, 'info');
        } else if (action === 'edit') {
          showToast(`正在编辑交易 ${id}`, 'info');
        } else if (action === 'delete') {
          // Bug #219 - 导出进行中不允许删除，防止数据不一致
          if (DataVision.exportInProgress) {
            showToast('导出进行中，请稍后再删除', 'warning');
            return;
          }
          // Bug #53 - Actually remove the transaction from allTransactions
          const idx = allTransactions.findIndex(t => t.id === id);
          if (idx !== -1) {
            allTransactions.splice(idx, 1);
            // Bug #121 - 删除后智能调整页码，不跳回第1页
            applyFilters({ fromDelete: true });
            showToast(`交易 ${id} 已删除`, 'warning');
          }
        }

        closeAllDropdowns();
      });
    });
  });
}

/**
 * 关闭所有操作下拉菜单
 */
function closeAllDropdowns() {
  DVLogger.init('closeAllDropdowns');
  // Bug #226 - 添加 isConnected 检查，防止已移除的元素再次 remove 报错
  document.querySelectorAll('.action-dropdown').forEach(d => {
    if (d.isConnected) d.remove();
  });
}

/**
 * 关闭所有面板（下拉菜单、筛选面板、通知面板）
 * Bug #20 - Note: This function uses display:none directly instead of CSS classes.
 * This is a known design inconsistency. Changing to CSS classes would require
 * significant refactoring of the notification panel animation, so it is left
 * as-is for now. If a refactor is done, consider using a .panel-open class approach.
 */
function closeAllPanels() {
  DVLogger.init('closeAllPanels');
  closeAllDropdowns();
  // Close filter panel
  const filterPanel = document.querySelector('.filter-panel');
  if (filterPanel) filterPanel.style.display = 'none';
  // Bug #7 - Clean up filter panel resize listener
  if (DataVision.handlers.filterResize) {
    window.removeEventListener('resize', DataVision.handlers.filterResize);
    DataVision.handlers.filterResize = null;
  }
  // Close notification panel
  const notifPanel = document.querySelector('.notification-panel');
  if (notifPanel) notifPanel.style.display = 'none';
  // Bug #48 - Clean up resize listener when panel closes
  if (DataVision.handlers.notifResize) {
    window.removeEventListener('resize', DataVision.handlers.notifResize);
    DataVision.handlers.notifResize = null;
  }
}

// ==================== 通知面板 ====================

/**
 * 初始化通知按钮和通知面板
 * Bug #48 - Resize listener to update notification panel position
 * Bug #60 - "View all notifications" link handler
 * Bug #34 - escapeHtml on dynamic parts (low risk but added)
 */
function initNotifications() {
  DVLogger.init('initNotifications');
  const notifBtn = document.getElementById('notifications');
  if (!notifBtn) return;

  // 创建通知面板
  const notifPanel = document.createElement('div');
  notifPanel.className = 'notification-panel';
  notifPanel.style.cssText = `
    position:fixed;margin-top:8px;
    background:var(--bg-primary);border:1px solid var(--border);
    border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,0.15);
    width:340px;max-width:calc(100vw - 48px);z-index:200;display:none;overflow:hidden;
  `;
  notifPanel.innerHTML = `
    <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;">
      <span style="font-size:16px;font-weight:600;color:var(--text-primary);">通知</span>
      <span style="font-size:12px;color:var(--primary);cursor:pointer;" id="markAllRead">全部已读</span>
    </div>
    <div style="max-height:320px;overflow-y:auto;">
      <div class="notif-item" style="padding:14px 20px;border-bottom:1px solid var(--border-light);cursor:pointer;transition:background 0.15s;display:flex;gap:12px;align-items:flex-start;">
        <div style="width:36px;height:36px;border-radius:50%;background:rgba(16,185,129,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <div style="font-size:13px;font-weight:500;color:var(--text-primary);margin-bottom:2px;">订单 #TRX-2024-002 已完成支付</div>
          <div style="font-size:12px;color:var(--text-tertiary);">5分钟前</div>
        </div>
      </div>
      <div class="notif-item" style="padding:14px 20px;border-bottom:1px solid var(--border-light);cursor:pointer;transition:background 0.15s;display:flex;gap:12px;align-items:flex-start;">
        <div style="width:36px;height:36px;border-radius:50%;background:rgba(245,158,11,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div>
          <div style="font-size:13px;font-weight:500;color:var(--text-primary);margin-bottom:2px;">服务器负载超过 80% 阈值</div>
          <div style="font-size:12px;color:var(--text-tertiary);">15分钟前</div>
        </div>
      </div>
      <div class="notif-item" style="padding:14px 20px;cursor:pointer;transition:background 0.15s;display:flex;gap:12px;align-items:flex-start;">
        <div style="width:36px;height:36px;border-radius:50%;background:rgba(239,68,68,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <div style="font-size:13px;font-weight:500;color:var(--text-primary);margin-bottom:2px;">订单 #TRX-2024-005 支付失败</div>
          <div style="font-size:12px;color:var(--text-tertiary);">30分钟前</div>
        </div>
      </div>
    </div>
    <div style="padding:12px;text-align:center;border-top:1px solid var(--border);">
      <span id="viewAllNotifications" style="font-size:13px;color:var(--primary);cursor:pointer;">查看全部通知</span>
    </div>
  `;

  // 设置按钮容器为相对定位
  document.body.appendChild(notifPanel);

  // 点击通知按钮切换面板
  notifBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    closeAllPanels();
    const isVisible = notifPanel.style.display === 'block';
    if (!isVisible) {
      const rect = notifBtn.getBoundingClientRect();
      notifPanel.style.top = (rect.bottom + 8) + 'px';
      notifPanel.style.right = (window.innerWidth - rect.right) + 'px';
      notifPanel.style.display = 'block';
      const badge = notifBtn.querySelector('.badge');
      if (badge) badge.style.display = 'none';

      // Bug #48, #105 - Add resize listener to update position when visible
      // Bug #156 - 先移除旧的 resize 监听器再添加新的
      if (DataVision.handlers.notifResize) {
        window.removeEventListener('resize', DataVision.handlers.notifResize);
      }
      DataVision.handlers.notifResize = () => {
        if (notifPanel.style.display === 'block') {
          const r = notifBtn.getBoundingClientRect();
          notifPanel.style.top = (r.bottom + 8) + 'px';
          notifPanel.style.right = (window.innerWidth - r.right) + 'px';
        }
      };
      window.addEventListener('resize', DataVision.handlers.notifResize);
    } else {
      notifPanel.style.display = 'none';
    }
  });

  // 通知项悬停效果
  notifPanel.querySelectorAll('.notif-item').forEach(item => {
    item.addEventListener('mouseenter', () => {
      item.style.background = 'var(--bg-secondary)';
    });
    item.addEventListener('mouseleave', () => {
      item.style.background = 'transparent';
    });
  });

  // 全部已读
  const markAllRead = document.getElementById('markAllRead');
  if (markAllRead) {
    markAllRead.addEventListener('click', (e) => {
      e.stopPropagation();
      showToast('所有通知已标记为已读', 'success');
    });
  }

  // Bug #60 - "View all notifications" link handler
  const viewAllNotifs = document.getElementById('viewAllNotifications');
  if (viewAllNotifs) {
    viewAllNotifs.addEventListener('click', (e) => {
      e.stopPropagation();
      showToast('通知中心功能开发中', 'info');
    });
  }
}

// ==================== 日志系统 ====================

/**
 * 初始化日志区域
 * Bug #33 - XSS in log messages: wrap with escapeHtml()
 * Bug #63 - Log level detection uses data-level attribute instead of classList[1]
 */
function initLogs() {
  DVLogger.init('initLogs');
  const logContent = document.getElementById('logContent');
  if (!logContent) return;

  const logs = [
    { level: 'info', time: '10:42:15', message: '系统启动成功，所有服务正常运行' },
    { level: 'info', time: '10:41:32', message: '数据库连接池已初始化，当前连接数: 10' },
    { level: 'warning', time: '10:40:18', message: 'API 响应时间超过阈值: 2.3s' },
    { level: 'info', time: '10:39:45', message: '缓存清理任务执行完成，释放 128MB 内存' },
    { level: 'error', time: '10:38:22', message: '订单服务异常: 连接超时' },
    { level: 'info', time: '10:37:56', message: '用户登录成功: user_12345' },
    { level: 'info', time: '10:36:41', message: '定时任务执行: 数据备份完成' },
    { level: 'warning', time: '10:35:29', message: '磁盘使用率超过 80%: /var/log' }
  ];

  const levelMap = {
    info: 'info',
    warning: 'warning',
    error: 'error'
  };

  // Bug #33 - escapeHtml on log.message
  // Bug #63 - Add data-level attribute to log-level elements
  logContent.innerHTML = logs.map(log => `
    <div class="log-item">
      <div class="log-level ${levelMap[log.level]}" data-level="${log.level}"></div>
      <div class="log-time">${log.time}</div>
      <div class="log-message">${escapeHtml(log.message)}</div>
    </div>
  `).join('');

  // 日志过滤按钮
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const level = btn.dataset.level;
      // Bug #44 - Track current filter level in module-level variable
      currentLogLevel = level;
      DVLogger.state('currentLogLevel', currentLogLevel);
      const logItems = logContent.querySelectorAll('.log-item');

      logItems.forEach(item => {
        // Bug #63 - Use dataset.level instead of classList[1]
        const itemLevel = item.querySelector('.log-level').dataset.level;
        if (level === 'all' || itemLevel === level) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
}

// ==================== 主题切换 ====================

/**
 * 初始化主题切换功能，并在切换时更新所有图表颜色
 */
function initThemeToggle() {
  DVLogger.init('initThemeToggle');
  const themeToggle = document.getElementById('themeToggle');
  if (!themeToggle) return;

  // Bug #9 - Wrap localStorage.getItem in try-catch
  let savedTheme = 'light';
  try {
    savedTheme = localStorage.getItem('theme') || 'light';
  } catch (e) {
    // localStorage may be unavailable (private browsing, quota exceeded, etc.)
  }
  document.documentElement.setAttribute('data-theme', savedTheme);

  themeToggle.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'light' ? 'dark' : 'light';

    document.documentElement.setAttribute('data-theme', newTheme);
    // Bug #9 - Wrap localStorage.setItem in try-catch
    try {
      localStorage.setItem('theme', newTheme);
    } catch (e) {
      // localStorage may be unavailable
    }

    // Bug #142 - 使用 debounce 替代锁，确保快速双击时最终状态一致
    if (DataVision.themeDebounceTimer) {
      clearTimeout(DataVision.themeDebounceTimer);
    }
    DataVision.themeDebounceTimer = setTimeout(() => {
      DVLogger.timer('setTimeout', 'themeDebounce');
      updateChartsTheme();
      DataVision.themeDebounceTimer = null;
    }, 150);
  });
}

/**
 * 更新所有图表的主题颜色（深色/浅色模式适配）
 * 使用 getComputedStyle 读取 CSS 变量值
 * Bug #91 - 添加主题更新锁防止竞态条件
 */
function updateChartsTheme() {
  DVLogger.init('updateChartsTheme');
  // Bug #167 - 移除 themeUpdateLock，依赖 initThemeToggle 中的 debounce 机制
  // 延迟一帧确保 CSS 变量已更新
  requestAnimationFrame(() => {
    const colors = getChartThemeColors();

    DataVision.chartInstances.forEach(chart => {
      if (!chart || !chart.options) return;
      
      // 更新图例文字颜色
      if (chart.options.plugins && chart.options.plugins.legend && chart.options.plugins.legend.labels) {
        chart.options.plugins.legend.labels.color = colors.textSecondary;
      }

      // 更新坐标轴颜色
      if (chart.options.scales) {
        Object.values(chart.options.scales).forEach(scale => {
          if (scale.ticks) {
            scale.ticks.color = colors.textTertiary;
          }
          if (scale.grid && scale.grid.color !== undefined) {
            scale.grid.color = colors.border;
          }
        });
      }

      // 更新仪表盘背景色
      if (chart.options.circumference === 180) {
        const mainColor = chart.data.datasets[0].backgroundColor[0];
        chart.data.datasets[0].backgroundColor = [mainColor, colors.border];
      }

      chart.update('none');
    });
  });
}

// ==================== 实时数据更新 ====================

/**
 * 模拟实时数据更新
 * - 每5秒更新仪表盘数值（随机波动）
 * - 每10秒添加新日志（限制最大50条，带入场动画）
 * Bug #33, #86 - XSS防护和日志DOM节点管理
 * Bug #44 - Real-time logs respect filter state
 * Bug #46 - Removed redundant gauge backgroundColor reassignment
 * Bug #63 - Add data-level attribute to new log items
 * Bug #84, #85 - 使用命名空间管理定时器
 */
function simulateRealtimeUpdates() {
  DVLogger.init('simulateRealtimeUpdates');
  // 清理现有定时器
  if (DataVision.intervals.gauge) { DVLogger.timer('clearInterval', 'gauge'); clearInterval(DataVision.intervals.gauge); }
  if (DataVision.intervals.log) { DVLogger.timer('clearInterval', 'log'); clearInterval(DataVision.intervals.log); }

  // Bug #141, #152 - 清理所有挂起的日志清理 setTimeout
  DataVision.logCleanupTimers.forEach(timerId => clearTimeout(timerId));
  DataVision.logCleanupTimers = [];

  // 每5秒更新仪表盘数值
  DVLogger.timer('setInterval', 'gauge');
  DataVision.intervals.gauge = setInterval(() => {
    // Bug #87 - 改进的均值回归算法
    Object.keys(DataVision.gaugeCharts).forEach(id => {
      const chart = DataVision.gaugeCharts[id];
      if (!chart || !chart.data || !chart.data.datasets) return;

      const currentValue = chart.data.datasets[0].data[0];
      // Bug #87 - 改进的均值回归算法：使用更平滑的回归和更合理的波动
      const initialValue = chart._initialGaugeValue || 50;
      // 向初始值回归的力度
      const regressionStrength = 0.1;
      const drift = (initialValue - currentValue) * regressionStrength;
      // 随机波动范围减小，使数据更稳定
      const randomFluctuation = (Math.random() - 0.5) * 5;
      let newValue = currentValue + drift + randomFluctuation;
      // 限制在 5-95 之间
      newValue = Math.max(5, Math.min(95, newValue));
      newValue = Math.round(newValue);

      chart.data.datasets[0].data = [newValue, 100 - newValue];
      chart.update('none');

      // 更新仪表盘文字
      const gaugeCard = chart.canvas.closest('.gauge-card');
      if (gaugeCard) {
        const gaugeValueEl = gaugeCard.querySelector('.gauge-value');
        if (gaugeValueEl) {
          if (id === 'networkGauge') {
            // 网络流量显示为 GB/s
            const gbValue = (newValue / 100 * 5).toFixed(1);
            gaugeValueEl.textContent = gbValue + 'GB/s';
          } else {
            gaugeValueEl.textContent = newValue + '%';
          }
        }
      }
    });
  }, 5000);

  // 每10秒添加新日志
  DataVision.intervals.log = setInterval(() => {
    DVLogger.timer('setInterval', 'log');
    const logContent = document.getElementById('logContent');
    if (!logContent) return;

    const messages = [
      { level: 'info', message: '用户访问首页' },
      { level: 'info', message: '订单创建成功' },
      { level: 'info', message: '数据同步完成' },
      { level: 'info', message: '缓存命中: 95%' },
      { level: 'info', message: 'API 请求: 200ms' },
      { level: 'warning', message: '内存使用率偏高: 85%' },
      { level: 'error', message: '第三方服务响应超时' },
      { level: 'info', message: '定时任务执行完成' },
      { level: 'warning', message: '请求队列积压: 150' },
      { level: 'info', message: '数据库查询优化完成' }
    ];

    const now = new Date();
    const time = now.toTimeString().split(' ')[0];
    const randomMsg = messages[Math.floor(Math.random() * messages.length)];

    const logItem = document.createElement('div');
    logItem.className = 'log-item';
    logItem.style.cssText = 'opacity:0;transform:translateY(-10px);transition:opacity 0.3s ease,transform 0.3s ease;';
    // Bug #33 - escapeHtml on randomMsg.message
    // Bug #63 - Add data-level attribute
    logItem.innerHTML = `
      <div class="log-level ${randomMsg.level}" data-level="${randomMsg.level}"></div>
      <div class="log-time">${time}</div>
      <div class="log-message">${escapeHtml(randomMsg.message)}</div>
    `;

    // Bug #44 - Check current active filter level; hide if doesn't match
    if (currentLogLevel !== 'all' && randomMsg.level !== currentLogLevel) {
      logItem.style.display = 'none';
    }

    logContent.insertBefore(logItem, logContent.firstChild);

    // 入场动画
    requestAnimationFrame(() => {
      logItem.style.opacity = '1';
      logItem.style.transform = 'translateY(0)';
    });

    // Bug #86 - 限制日志最大30条（从50减少到30），更积极清理
    const maxLogs = 30;
    while (logContent.children.length > maxLogs) {
      const oldChild = logContent.lastChild;
      if (oldChild) {
        // 先淡出再移除，避免DOM操作卡顿
        oldChild.style.opacity = '0';
        // Bug #141, #152 - 跟踪 setTimeout ID 以便后续清理
        const cleanupTimer = setTimeout(() => {
          DVLogger.timer('setTimeout', 'logCleanup');
          if (oldChild.parentNode) oldChild.remove();
          // Bug #157 - 执行后从数组中移除
          const idx = DataVision.logCleanupTimers.indexOf(cleanupTimer);
          if (idx !== -1) DataVision.logCleanupTimers.splice(idx, 1);
        }, 300);
        DataVision.logCleanupTimers.push(cleanupTimer);
      }
    }
  }, 10000);
}

// ==================== 报表页面功能 ====================

/**
 * 初始化报表页面功能
 * - 报表生成器表单提交
 * - 报表列表的下载/预览/删除按钮
 * Bug #36 - Report search not functional
 * Bug #52 - Report delete has no confirmation
 * Bug #37 - Report refresh button no function
 */
function initReportActions() {
  DVLogger.init('initReportActions');
  // 报表生成器 - 生成报表按钮
  const generateBtn = document.getElementById('generateReportBtn');
  if (generateBtn) {
    generateBtn.addEventListener('click', () => {
      const reportType = document.getElementById('reportType');
      const reportDateRange = document.getElementById('reportDateRange');
      const reportFormat = document.getElementById('reportFormat');

      const typeText = reportType.options[reportType.selectedIndex].text;
      const rangeText = reportDateRange.options[reportDateRange.selectedIndex].text;
      const formatText = reportFormat.options[reportFormat.selectedIndex].text;

      showToast(`${typeText}（${rangeText}）生成任务已提交，格式: ${formatText}`, 'success');
    });
  }

  // 报表生成器 - 定时生成按钮
  const scheduleBtn = document.getElementById('scheduleReportBtn');
  if (scheduleBtn) {
    scheduleBtn.addEventListener('click', () => {
      showToast('定时生成任务已设置', 'success');
    });
  }

  // Bug #37 - Report refresh button handler
  const refreshBtn = document.querySelector('#reports .table-actions .btn-secondary');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      showToast('报表列表已刷新', 'success');
    });
  }

  // Bug #36, #96, #97, #103 - Report search functionality with debounce and special char handling
  const reportSearchInput = document.querySelector('#reports .search-box input');
  if (reportSearchInput) {
    reportSearchInput.addEventListener('input', (e) => {
      // Bug #96 - 添加防抖
      if (DataVision.reportSearchDebounceTimer) {
        clearTimeout(DataVision.reportSearchDebounceTimer);
      }
      DataVision.reportSearchDebounceTimer = setTimeout(() => {
        DVLogger.timer('setTimeout', 'reportSearchDebounce');
        const rawQuery = e.target.value.trim();
        // Bug #119 - 使用原始值进行includes匹配，移除无用的正则转义
        const query = rawQuery.toLowerCase();
        const reportTable = document.querySelector('#reports .data-table');
        if (!reportTable) return;
        const rows = reportTable.querySelectorAll('tbody tr');
        let visibleCount = 0;
        rows.forEach(row => {
          const nameCell = row.querySelector('td');
          if (nameCell) {
            const name = nameCell.textContent.trim().toLowerCase();
            const isMatch = !query || name.includes(query);
            row.style.display = isMatch ? '' : 'none';
            if (isMatch) visibleCount++;
          }
        });
        // Bug #103 - 显示无结果提示
        const tbody = reportTable.querySelector('tbody');
        let noResultRow = tbody.querySelector('.no-results-row');
        if (visibleCount === 0) {
          if (!noResultRow) {
            noResultRow = document.createElement('tr');
            noResultRow.className = 'no-results-row';
            const colCount = reportTable.querySelectorAll('thead th').length || 7;
            noResultRow.innerHTML = `<td colspan="${colCount}" style="text-align:center;padding:48px 20px;color:var(--text-tertiary);">未找到匹配的报表</td>`;
            tbody.appendChild(noResultRow);
            DVLogger.branch('reportSearch_noResults', true);
          }
        } else if (noResultRow) {
          noResultRow.remove();
          DVLogger.branch('reportSearch_noResults', false);
        }
      }, 300);
    });
  }

  // 报表列表操作按钮
  const reportTable = document.querySelector('#reports .data-table');
  if (reportTable) {
    reportTable.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-icon');
      if (!btn) return;

      // 找到所在行的报表名称
      const row = btn.closest('tr');
      const reportName = row ? row.querySelector('td')?.textContent.trim() : '报表';

      // 判断按钮类型（通过 SVG 图标区分）
      const svgPath = btn.querySelector('path')?.getAttribute('d') || '';

      // 下载按钮：包含 "M21 15v4" 和 "M7 10 12 15 17 10"
      if (svgPath.includes('M21 15v4') && svgPath.includes('M7 10')) {
        showToast(`正在下载: ${reportName}`, 'success');
      }
      // 预览按钮：包含 "M1 12s4-8"
      else if (svgPath.includes('M1 12s4-8')) {
        showToast(`正在预览: ${reportName}`, 'info');
      }
      // 删除按钮：包含 "M19 6v14"
      else if (svgPath.includes('M19 6v14') || svgPath.includes('M3 6 5 6 21 6')) {
        // Bug #52 - Add confirmation before deleting
        if (!window.confirm(`确定要删除报表 "${reportName}" 吗？`)) return;
        // Bug #149 - 添加 row 空值检查
        if (!row) return;
        // 删除行（带淡出动画）
        row.style.transition = 'opacity 0.3s, transform 0.3s';
        row.style.opacity = '0';
        row.style.transform = 'translateX(20px)';
        setTimeout(() => {
          row.remove();
          showToast(`${reportName} 已删除`, 'warning');
          // Bug #149 - 更新报表列表的 page-info 计数
          const pageInfo = document.querySelector('#reports .page-info');
          if (pageInfo) {
            const tbody = reportTable.querySelector('tbody');
            const remainingRows = tbody ? tbody.querySelectorAll('tr:not(.no-results-row)').length : 0;
            pageInfo.textContent = `显示 ${remainingRows > 0 ? 1 : 0}-${remainingRows} 共 ${remainingRows} 条`;
          }
        }, 300);
      }
    });
  }
}

// ==================== 杂项按钮功能 ====================

/**
 * 初始化杂项按钮功能
 * Bug #39 - New A/B test button
 * Bug #43 - Data source links
 * Bug #55 - Chart refresh/settings buttons (overview)
 * Bug #56 - Analysis chart refresh buttons
 */
function initMiscButtons() {
  DVLogger.init('initMiscButtons');
  // Bug #39 - New A/B test button
  const newTestBtn = document.querySelector('#analytics .table-actions .btn-secondary');
  if (newTestBtn) {
    newTestBtn.addEventListener('click', () => {
      showToast('新建测试功能开发中', 'info');
    });
  }

  // Bug #43 - Data source links (sidebar links without # href)
  const dataSourceLinks = document.querySelectorAll('.sidebar-section .sidebar-link:not([href^="#"])');
  dataSourceLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      showToast('功能开发中', 'info');
    });
  });

  // Bug #55 - Chart refresh and settings buttons on overview page
  const overviewChartActions = document.querySelectorAll('#overview .chart-actions');
  overviewChartActions.forEach(actionGroup => {
    const buttons = actionGroup.querySelectorAll('.btn-icon');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const ariaLabel = btn.getAttribute('aria-label') || '';
        if (ariaLabel.includes('刷新')) {
          // Regenerate random data for the chart
          const chartCard = btn.closest('.chart-card');
          if (chartCard) {
            const canvas = chartCard.querySelector('canvas');
            if (canvas) {
              const chart = chartInstances.find(c => c.canvas === canvas);
              if (chart) {
                // Bug #6 - Skip gauge charts (circumference === 180) to preserve sum=100
                if (chart.options.circumference === 180) {
                  showToast('仪表盘数据由系统实时更新', 'info');
                  return;
                }
                chart.data.datasets.forEach(dataset => {
                  if (Array.isArray(dataset.data)) {
                    dataset.data = dataset.data.map(v => {
                      if (typeof v === 'number') {
                        const variation = v * (0.8 + Math.random() * 0.4);
                        return Math.round(variation);
                      }
                      return v;
                    });
                    // Bug #239 - 漏斗图数据单调递减检查
                    if (chart.config.type === 'bar' && chart.canvas.id === 'funnelChart') {
                      let prev = dataset.data[0];
                      for (let i = 1; i < dataset.data.length; i++) {
                        if (dataset.data[i] > prev) {
                          dataset.data[i] = Math.max(1, prev - Math.floor(Math.random() * prev * 0.2));
                        }
                        prev = dataset.data[i];
                      }
                    }
                  }
                });
                chart.update();
              }
            }
          }
          showToast('图表数据已刷新', 'success');
        } else if (ariaLabel.includes('设置')) {
          showToast('图表设置功能开发中', 'info');
        }
      });
    });
  });

      // Bug #56 - Analysis chart refresh buttons
  const analyticsChartActions = document.querySelectorAll('#analytics .chart-actions');
  analyticsChartActions.forEach(actionGroup => {
    const buttons = actionGroup.querySelectorAll('.btn-icon');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const ariaLabel = btn.getAttribute('aria-label') || '';
        if (ariaLabel.includes('刷新')) {
          const chartCard = btn.closest('.chart-card');
          if (chartCard) {
            const canvas = chartCard.querySelector('canvas');
            if (canvas) {
              const chart = chartInstances.find(c => c.canvas === canvas);
              if (chart) {
                // Bug #6 - Skip gauge charts to preserve sum=100
                if (chart.options.circumference === 180) {
                  showToast('仪表盘数据由系统实时更新', 'info');
                  return;
                }
                chart.data.datasets.forEach(dataset => {
                  if (Array.isArray(dataset.data)) {
                    dataset.data = dataset.data.map(v => {
                      if (typeof v === 'number') {
                        const variation = v * (0.8 + Math.random() * 0.4);
                        return Math.round(variation);
                      }
                      return v;
                    });
                  }
                });
                // Bug #231 - 漏斗图数据必须单调递减
                if (canvas.id === 'funnelChart' && chart.data.datasets[0]) {
                  const funnelData = chart.data.datasets[0].data;
                  for (let i = 1; i < funnelData.length; i++) {
                    if (funnelData[i] > funnelData[i - 1]) {
                      funnelData[i] = funnelData[i - 1];
                    }
                  }
                }
                chart.update();
              }
            }
          }
          showToast('图表数据已刷新', 'success');
        }
      });
    });
  });
}

// ==================== 全局事件处理 ====================

/**
 * Bug #61, #94, #95 - Consolidate multiple document click listeners into one with throttling
 * Bug #54 - Add Escape key listener to close all panels
 */
function initGlobalClickHandler() {
  DVLogger.init('initGlobalClickHandler');
  // Bug #94 - 使用事件委托优化性能
  // Bug #61 - Single document click listener
  DataVision.handlers.documentClick = (e) => {
    // Close dropdowns
    if (!e.target.closest('.action-dropdown') && !e.target.closest('.table-action-btn')) {
      closeAllDropdowns();
    }

    // Close filter panel
    const filterPanel = document.querySelector('.filter-panel');
    const filterBtn = document.querySelector('#overview .table-actions .btn-secondary');
    if (filterPanel && filterPanel.style.display === 'block' && !filterPanel.contains(e.target) && !filterBtn?.contains(e.target)) {
      filterPanel.style.display = 'none';
      // Bug #128 - 关闭filter panel时也清理resize监听器
      if (DataVision.handlers.filterResize) {
        window.removeEventListener('resize', DataVision.handlers.filterResize);
        DataVision.handlers.filterResize = null;
      }
    }

    // Close notification panel
    const notifPanel = document.querySelector('.notification-panel');
    const notifBtn = document.getElementById('notifications');
    if (notifPanel && !notifPanel.contains(e.target) && !notifBtn?.contains(e.target)) {
      notifPanel.style.display = 'none';
      // Bug #48 - Clean up resize listener
      if (DataVision.handlers.notifResize) {
        window.removeEventListener('resize', DataVision.handlers.notifResize);
        DataVision.handlers.notifResize = null;
      }
    }
  };
  document.addEventListener('click', DataVision.handlers.documentClick);

  // Bug #54 - Escape key to close all panels
  DataVision.handlers.keydown = (e) => {
    if (e.key === 'Escape') {
      closeAllPanels();
    }
  };
  document.addEventListener('keydown', DataVision.handlers.keydown);

  // Bug #8, #95 - Scroll should close all floating panels with throttling
  // Bug #211 - 使用命名空间管理 scrollDebounceTimer
  DataVision.handlers.scroll = () => {
    if (DataVision.scrollDebounceTimer) return;
    DataVision.scrollDebounceTimer = setTimeout(() => {
      DVLogger.timer('setTimeout', 'scrollDebounce');
      closeAllPanels();
      DataVision.scrollDebounceTimer = null;
    }, 100);
  };
  window.addEventListener('scroll', DataVision.handlers.scroll, { passive: true });
}
